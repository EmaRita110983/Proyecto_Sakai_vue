# URL base de la API del backend Laravel, incluyendo el prefijo /api.
# Obligatoria en build de producción (src/service/api.js): sin ella, el build
# falla explícitamente en vez de caer en silencio a http:// sin cifrar contra
# el mismo host. En desarrollo (npm run dev) es opcional — si falta, cae
# automáticamente a http://<hostname-actual>:8000/api.
VITE_API_URL=https://api.tu-dominio.com/api
